{
  "note": "Agent HQ metadata, not an opencode config key",
  "memory": {
    "bank_path": ".memory/",
    "archive_ttl_days": 7,
    "compression": {
      "enabled": true,
      "max_size_kb": 50,
      "strategy": "summary+archive"
    }
  },
  "workspace": {
    "root": "D:\\Тест\\agent-hq",
    "sandbox_per_agent": true,
    "merge_strategy": "git-branch"
  },
  "projects": {
    "news-bot": {
      "type": "telegram-bot",
      "agents": [
        "backend",
        "devops",
        "qa-engineer",
        "tech-writer"
      ]
    },
    "pong-advanced": {
      "type": "full-stack",
      "agents": [
        "frontend",
        "backend",
        "devops",
        "qa-engineer"
      ]
    }
  },
  "modules": {
    "memory_bank": true,
    "agent_sandbox": true,
    "model_router": true,
    "context_compression": true,
    "distributed_tracing": true,
    "performance_scoring": true,
    "plugins": true,
    "health_monitoring": true
  }
}
