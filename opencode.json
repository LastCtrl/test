{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "context7-mcp.cmd"
      ],
      "enabled": true
    },
    "hermes-atlas-mcp": {
      "type": "local",
      "command": [
        "hermes-atlas-mcp.cmd"
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "mcp-server-sequential-thinking.cmd"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project-from-cwd"
      ],
      "enabled": false,
      "timeout": 30000,
      "cwd": ".",
      "environment": {
        "HTTP_PROXY": "http://127.0.0.1:3128",
        "HTTPS_PROXY": "http://127.0.0.1:3128",
        "NO_PROXY": "localhost,127.0.0.1,10.*,192.168.*,*.minsk.energo.net"
      }
    }
  },
  "command": {
    "new-project": {
      "template": "Создай новый проект в .agents/projects/ по выбранному шаблону (full-stack/api-only/mobile/data-pipeline): структуру папок, базовые конфиги, README. Используй .agents/scripts/create-project.ps1 если есть. Спроси тип проекта если не задан.",
      "description": "Создать новый проект по шаблону (full-stack/api-only/mobile/data-pipeline)."
    },
    "cost-report": {
      "template": "Сформируй отчёт по стоимости сессий: прочитай файлы из %LOCALAPPDATA%\\opencode\\agent-hq-traces\\ (traces.jsonl и performance.jsonl). Посчитай суммарные токены/время/ошибки по агентам и сессиям. Выведи таблицей. Если данных нет — сообщи об этом.",
      "description": "Отчёт по стоимости и токенам из трейсов."
    },
    "team-report": {
      "template": "Сформируй отчёт команды agent-hq: кто работал (агенты), какие задачи (из .memory/inbox/outbox), результаты ревью, рейтинг моделей (.memory/ratings.jsonl). Сохрани в .memory/reports/team-report-<date>.md.",
      "description": "Сформировать отчёт команды из трейсов и Memory Bank."
    },
    "sync": {
      "template": "Синхронизируй состояние системы: перегенерируй .memory/activeContext.md, progress.md, decisionLog.md из CONTEXT-BUFFER.md и KNOWLEDGE-BASE.md. Обнови секцию agent в opencode.json из .opencode/agents/*.json через .agents/scripts/sync-agents.ps1. Запиши результат в CONTEXT-BUFFER.md.",
      "description": "Синхронизация агентов и Memory Bank из CONTEXT-BUFFER/KNOWLEDGE-BASE."
    },
    "status": {
      "template": "Покажи статус системы agent-hq: список агентов из registry.json, состояние Memory Bank (.memory/), активные worktrees (.agents/worktrees/), результат health-check. Запусти .agents/scripts/health-check.ps1 если есть. Ответ кратко, таблицей.\n\n## Agents & Utilization\nПосле базового статуса покажи секцию 'Agents & Utilization':\n1. Запусти `.agents/scripts/agent-registry.ps1 -List` и покажи таблицу: Агент | Статус | Проект | Задача\n2. Запусти `.agents/scripts/agent-utilization.ps1` и покажи вывод: сводка, busy по проектам, free по ролям, алерты, последние 5 назначений из аудит-лога.",
      "description": "Статус системы agent-hq: агенты, utilization, Memory Bank, worktrees, здоровье."
    }
  },
