{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "hermes-atlas-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "hermes-atlas-mcp"
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server"
      ],
      "enabled": true
    }
  },
  "command": {
    "new-project": {
      "template": "Создай новый проект в .agents/projects/ по выбранному шаблону (full-stack/api-only/mobile/data-pipeline): структуру папок, базовые конфиги, README. Используй .agents/scripts/create-project.ps1 если есть. Спроси тип проекта если не задан.",
      "description": "Создать новый проект по шаблону (full-stack/api-only/mobile/data-pipeline)."
    },
    "cost-report": {
      "template": "Сформируй отчёт по стоимости сессий: прочитай файлы из %LOCALAPPDATA%\\opencode\\agent-hq-traces\\ (traces.jsonl и performance.jsonl). Посчитай суммарные токены/время/ошибки по агентам и сессиям. Выведи таблицей. Если данных нет — сообщи об этом.",
      "description": "Отчёт по стоимости и токенам из трейсов."
    },
    "team-report": {
      "template": "Сформируй отчёт команды agent-hq: кто работал (агенты), какие задачи (из .memory/inbox/outbox), результаты ревью, рейтинг моделей (.memory/ratings.jsonl). Сохрани в .memory/reports/team-report-<date>.md.",
      "description": "Сформировать отчёт команды из трейсов и Memory Bank."
    },
    "sync": {
      "template": "Синхронизируй состояние системы: перегенерируй .memory/activeContext.md, progress.md, decisionLog.md из CONTEXT-BUFFER.md и KNOWLEDGE-BASE.md. Обнови секцию agent в opencode.json из .opencode/agents/*.json через .agents/scripts/sync-agents.ps1. Запиши результат в CONTEXT-BUFFER.md.",
      "description": "Синхронизация агентов и Memory Bank из CONTEXT-BUFFER/KNOWLEDGE-BASE."
    },
    "status": {
      "template": "Покажи статус системы agent-hq: список агентов из registry.json, состояние Memory Bank (.memory/), активные worktrees (.agents/worktrees/), результат health-check. Запусти .agents/scripts/health-check.ps1 если есть. Ответ кратко, таблицей.",
      "description": "Статус системы agent-hq: агенты, Memory Bank, worktrees, здоровье."
    }
  },
  "agents": {
    "defaults": {
      "temperature": 0.2,
      "skills_first": true,
      "max_retries": 2
    },
    "models": {
      "primary": "opencode/mimo-v2.5-free",
      "fast": "opencode/nemotron-3.5-lightning-free",
      "fallback": "opencode/nemotron-3-ultra-free"
    }
  },
  "memory": {
    "bank_path": ".memory/",
    "archive_ttl_days": 7,
    "compression": {
      "enabled": true,
      "max_size_kb": 50,
      "strategy": "summary+archive"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 15
  },
  "watcher": {
    "ignore": [
      ".memory/**",
      ".agents/worktrees/**"
    ]
  },
  "workspace": {
    "root": "D:\\Тест\\agent-hq",
    "sandbox_per_agent": true,
    "merge_strategy": "git-branch"
  },
  "projects": {
    "news-bot": {
      "type": "telegram-bot",
      "agents": [
        "backend",
        "devops",
        "qa-engineer",
        "tech-writer"
      ]
    },
    "pong-advanced": {
      "type": "full-stack",
      "agents": [
        "frontend",
        "backend",
        "devops",
        "qa-engineer"
      ]
    }
  },
  "modules": {
    "memory_bank": true,
    "agent_sandbox": true,
    "model_router": true,
    "context_compression": true,
    "distributed_tracing": true,
    "performance_scoring": true,
    "plugins": true,
    "health_monitoring": true
  },
  "agent": {
    "backend": {
        "description": "Backend Specialist — REST/GraphQL API, бизнес-логика, middleware, авторизация.",
        "mode": "subagent",
        "model": "opencode/nemotron-3.5-lightning-free",
        "temperature": 0.2,
        "permission": {
            "bash": "allow",
            "edit": "allow",
            "glob": "allow",
            "grep": "allow",
            "read": "allow",
            "skill": "allow",
            "task": "deny"
        },
        "prompt": "{file:.opencode/agents/prompts/backend.txt}"
    }
,
    "code-reviewer": {
        "description": "Code Reviewer — code review, best practices, clean code, антипаттерны. Только чтение.",
        "mode": "subagent",
        "model": "opencode/nemotron-3-ultra-free",
        "temperature": 0.1,
        "permission": {
            "bash": "deny",
            "edit": "deny",
            "glob": "allow",
            "grep": "allow",
            "question": "allow",
